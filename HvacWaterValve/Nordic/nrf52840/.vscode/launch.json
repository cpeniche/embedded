{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "name": "nrf52 OpenOCD",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "serverpath": "${config:OpenocdPath}",
      "configFiles": [
        "${workspaceFolder}/openocd/minimodule-swd.cfg",
        "target/nrf52.cfg"
      ],
      "showDevDebugOutput": "vscode",
      "searchDir": [],
      "runToEntryPoint": "main",
      "gdbPath": "${config:armGDBPath}",
      "openOCDLaunchCommands": ["init", "nrf52_recover"]
    },
    {
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "name": "nrf52 No Erase OpenOCD",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "serverpath": "${config:OpenocdPath}",
      "configFiles": [
        "${workspaceFolder}/openocd/minimodule-swd.cfg",
        "target/nrf52.cfg"
      ],
      "showDevDebugOutput": "vscode",
      "searchDir": [],
      "runToEntryPoint": "main",
      "gdbPath": "${config:armGDBPath}"
    },
    {
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "name": "nrf52 OpenOCD attach",
      "request": "attach",
      "type": "cortex-debug",
      "servertype": "openocd",
      "serverpath": "${config:OpenocdPath}",
      "configFiles": [
        "${workspaceFolder}/openocd/minimodule-swd.cfg",
        "target/nrf52.cfg"
      ],
      "showDevDebugOutput": "vscode",
      "searchDir": [],
      "runToEntryPoint": "main",
      "gdbPath": "${config:armGDBPath}"
    }
  ]
}
