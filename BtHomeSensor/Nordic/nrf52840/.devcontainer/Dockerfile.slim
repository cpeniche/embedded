# syntax=docker/dockerfile:1
#
# Slimmed-down variant of ./Dockerfile.
#
# podman build -t zephyr:v4.4-slim --build-arg USERNAME=vscode --progress plain --format=docker -f Dockerfile.slim ./
#
# Changes vs. the original Dockerfile:
#   - ubuntu:24.04 instead of ubuntu:latest: pins to a known-good release whose apt-provided
#     cmake (3.28) and python3 (3.12) already satisfy current Zephyr's minimum versions, so we
#     don't have to work around outdated toolchain packages one at a time. (debian:bookworm-slim
#     was tried first for a smaller base, but its cmake/python3 are too old for current Zephyr
#     and there's no easy way to get newer versions without pulling in a lot of extra machinery.)
#   - only the arm-zephyr-eabi SDK toolchain is installed (this board is nRF52840 only).
#     Pass --build-arg ZEPHYR_TOOLCHAINS="arm-zephyr-eabi xtensa-espressif_esp32s3_zephyr-elf"
#     if you also need ESP32 targets; the "west blobs fetch hal_espressif" step below is only
#     needed in that case too.
#   - OpenOCD is not built from source: `west sdk install` already bundles an OpenOCD binary
#     under the SDK's sysroots/.../usr/bin, and west's "openocd" runner uses that one
#     automatically. libusb-1.0-0 is kept in SYSTEM_UTILITIES below since that bundled binary
#     still needs it at runtime to talk to USB debug probes.
#   - apt/pip caches are cleaned in the same layer that creates them, so they don't bloat the
#     image (deleting in a later RUN does not shrink earlier layers).
#   - west update uses --narrow with a shallow git fetch to avoid pulling full module history.
#     Tradeoff: `west forall -c "git log"` and similar history-dependent commands won't work
#     fully; run `git fetch --unshallow` inside a module if you need its full history.

FROM ubuntu:24.04

SHELL ["/bin/bash", "-c"]
USER root

ARG USERNAME
ARG UID=1000
ARG GID=$UID
ARG ZEPHYR_TOOLCHAINS="arm-zephyr-eabi"
ARG COMPILATION_TOOLS="cmake ninja-build gperf ccache device-tree-compiler wget"
ARG VERSION_CONTROL_UTILITIES="git wget curl file gdisk uuid-runtime"
ARG PYTHON_UTILITIES="python3-dev python3-pip python3-setuptools python3-venv pipx"
ARG SYSTEM_UTILITIES="build-essential gcc g++ libusb-1.0-0 sudo ca-certificates locales"

ENV PIP_NO_CACHE_DIR=1

RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
        ${COMPILATION_TOOLS} ${VERSION_CONTROL_UTILITIES} ${PYTHON_UTILITIES} ${SYSTEM_UTILITIES} \
    && rm -rf /var/lib/apt/lists/*

# Python's requests/certifi ships its own CA bundle, which can lag behind the actively
# maintained system one (from the ca-certificates package) and reject roots it hasn't
# picked up yet (e.g. Sectigo's newer USERTrust ECC hierarchy). Point it at the system
# bundle so `west sdk install` (which calls the GitHub API via requests) verifies the
# same way git already does.
ENV SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
ENV REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# ubuntu:24.04 ships a default "ubuntu" user/group at uid/gid 1000, which collides with the
# useradd/groupadd below (which default to the same 1000). Remove it first.
RUN userdel -r ubuntu 2>/dev/null; if getent group ubuntu >/dev/null; then groupdel ubuntu; fi

RUN groupadd -g ${GID} ${USERNAME} \
    && useradd --uid $UID --gid $GID -m $USERNAME \
    && usermod -aG dialout,plugdev $USERNAME \
    && echo $USERNAME ALL=\(root\) NOPASSWD:ALL > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

RUN localedef -i en_US -c -f UTF-8 -A /usr/share/locale/locale.alias en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

COPY udev/60-openocd.rules /etc/udev/rules.d/60-openocd.rules

USER $USERNAME
WORKDIR /home/$USERNAME
ENV PATH=/home/$USERNAME/.local/bin:$PATH

RUN pipx install west && pipx ensurepath
RUN west init
RUN west config manifest.project-filter -- -hal_adi,-hal_afbr,-hal_ambiq,-hal_atmel,-hal_bouffalolab,-hal_ethos_u,-hal_gigadevice,-hal_infineon,-hal_microchip,-hal_nuvoton,-hal_nxp,-hal_openisa,-hal_quicklogic,-hal_realtek,-hal_renesas,-hal_rpi_pico,-hal_sifli,-hal_silabs,-hal_tdk,-hal_ti,-_hal_wch,-hal_wurthelektronik,-percepio,-segger
RUN west update --narrow -o=--depth=1
RUN west packages pip --install
RUN west zephyr-export
RUN west sdk install -b /home/$USERNAME -t $ZEPHYR_TOOLCHAINS

USER root
WORKDIR /home/${USERNAME}
ENV PATH=$PATH:/home/vscode/.local/share/pipx/venvs/west/bin
USER $USERNAME
