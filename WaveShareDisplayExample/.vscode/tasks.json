{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "command": "${command:workbench.action.files.saveAll}",
      "label": "SaveAllFiles",
      "type": "shell",
      "problemMatcher": []
    },
    {
      "label": "Flash",
      "type": "shell",
      "command": "export PATH=$PATH:/home/vscode/.local/share/pipx/venvs/west/bin; cd ~/zephyr; west flash --skip-rebuild -r openocd -d ${config:buildDirectory}",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Clean Build",
      "type": "shell",
      "command": "export PATH=$PATH:/home/vscode/.local/share/pipx/venvs/west/bin; cd ~/zephyr; west build -p always -b ${config:board} ${config:applicationDirectory} -d ${config:buildDirectory}",
      "group": "build",
      "dependsOn": ["SaveAllFiles"],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Build",
      "type": "shell",
      "command": "cd ~/zephyr; west build -p auto -b ${config:board} ${config:applicationDirectory} -d ${config:buildDirectory}",
      "group": "build",
      "dependsOn": ["SaveAllFiles"],
      "dependsOrder": "sequence",
      "problemMatcher": [],
      "options": {
        "env": {
          "ZEPHYR_BASE": "home/vscode/zephyr",
          "ZEPHYR_SDK_INSTALL_DIR": "/home/vscode/${config:zephyrSDKVersion}"
        }
      }
    }
  ]
}
