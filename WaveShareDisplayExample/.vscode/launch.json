{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [
    {
      "name": "(gdb) Launch",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "MIMode": "gdb",
      "preLaunchTask": "openocd",
      "cwd": "${workspaceFolder}",
      "miDebuggerPath": "${config:armGDBPath}",
      "miDebuggerServerAddress": "localhost:3333",
      "stopAtEntry": true,
      "useExtendedRemote": true,
      "svdPath": "${workspaceFolder}/openocd/STM32G431.svd",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "-gdb-set disassembly-flavor intel",
          "ignoreFailures": true
        },
        {
          "description": "Set Disassembly Flavor to Intel",
          "text": "monitor reset halt",
          "ignoreFailures": true
        }
      ],
      "logging": { "moduleLoad": true, "trace": false, "traceResponse": false }
    },
    {
      "cwd": "${workspaceRoot}",
      "executable": "${workspaceFolder}/build/zephyr/zephyr.elf",
      "name": "OpenOCD Debug",
      "request": "launch",
      "type": "cortex-debug",
      "servertype": "openocd",
      "configFiles": [
        "${workspaceFolder}/openocd/minimodule-swd.cfg",
        "target/stm32g4x.cfg"
      ],
      "showDevDebugOutput": "vscode",
      "searchDir": [],
      "runToEntryPoint": "main",
      "gdbPath": "${config:armGDBPath}",
      "svdFile": "${workspaceFolder}/openocd/STM32G431.svd"
    }
  ]
}
