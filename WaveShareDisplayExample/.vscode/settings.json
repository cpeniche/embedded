{
  "zephyrSDKVersion": "zephyr-sdk-1.0.1",
  "armGDBPath": "/home/vscode/${config:zephyrSDKVersion}/gnu/arm-zephyr-eabi/bin/arm-zephyr-eabi-gdb",
  "applicationDirectory": "${workspaceFolder}",
  "board": "nrf52840dongle/nrf52840/bare",
  "buildDirectory": "${workspaceFolder}/build",

  "cortex-debug.variableUseNaturalFormat": false,
  "files.associations": {
    "ff_gen_drv.h": "c",
    "functional": "c",
    "*.xc": "cpp",
    "*.tcc": "c",
    "bitset": "c",
    "typeinfo": "c",
    "array": "c",
    "string": "c",
    "string_view": "c",
    "initializer_list": "c",
    "regex": "c",
    "cryptography.h": "c"
  },
  "C_Cpp.default.compilerPath": "/home/vscode/zephyr-sdk-0.17.4/arm-zephyr-eabi/bin/arm-zephyr-eabi-gcc",
  "cmake.sourceDirectory": "/home/vscode/project",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools"
  },
  "mcu-debug.rtos-views.showRTOS": true,
  "VsCodeTaskButtons.showCounter": false,
  "VsCodeTaskButtons.tasks": [
    {
      "label": "$(rocket) Build",
      "task": "Build",
      "color": "default",
      "alignment": "left"
    },
    {
      "label": "$(rocket) Clean Build",
      "task": "Clean Build",
      "color": "default",
      "alignment": "left"
    }
  ]
}
