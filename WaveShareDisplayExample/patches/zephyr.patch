+
+		/*
+		 * ssd16xx_set_window()'s bounds check (in ssd16xx_write())
+		 * transposes which axis desc->width/desc->height get
+		 * validated against for ROTATED_90/270: x/width against
+		 * panel_h, y/height against config->width - the opposite of
+		 * NORMAL/ROTATED_180. Report resolution to match here too,
+		 * so callers (e.g. LVGL) see the actual valid flush bounds
+		 * for the current orientation directly, rather than always
+		 * the un-rotated native ones.
+		 */
+		if (data->orientation == DISPLAY_ORIENTATION_ROTATED_90 ||
+		    data->orientation == DISPLAY_ORIENTATION_ROTATED_270) {
+			caps->x_resolution = panel_h;
+			caps->y_resolution = config->width;
+		} else {
+			caps->x_resolution = config->width;
+			caps->y_resolution = panel_h;
+		}
+	}
+	/*
+	 * The driver writes RAM bits through unchanged; declaring the
+	 * format the other way round for panels whose black RAM plane is
+	 * optically inverted is what actually flips the sense of what
+	 * gets written - see the "inverted" comment on struct
+	 * ssd16xx_quirks.
+	 */
+	caps->supported_pixel_formats = config->quirks->inverted ?
+		PIXEL_FORMAT_MONO01 : PIXEL_FORMAT_MONO10;
+	caps->current_pixel_format = caps->supported_pixel_formats;
 	caps->screen_info = SCREEN_INFO_MONO_MSB_FIRST | SCREEN_INFO_EPD;
 
+	if (config->quirks->full_width_only) {
+		caps->screen_info |= SCREEN_INFO_X_ALIGNMENT_WIDTH;
+	}
+
 	if (data->orientation == DISPLAY_ORIENTATION_NORMAL ||
 	    data->orientation == DISPLAY_ORIENTATION_ROTATED_180) {
 		caps->screen_info |= SCREEN_INFO_MONO_VTILED;
@@ -787,6 +872,33 @@ static int ssd16xx_set_profile(const struct device *dev,
 		return err;
 	}
 
+	if (config->quirks->bypass_red_ram) {
+		/*
+		 * Full refresh always drives every pixel to a known target
+		 * state regardless of history, so the RED RAM plane can be
+		 * safely bypassed (upper nibble 0x4). Partial refresh needs
+		 * a proper old-vs-new differential to compute its fast
+		 * waveform, which means RED RAM (holding the shadow-copied
+		 * "old image", see the WRITE_RED_RAM call in
+		 * ssd16xx_write()) must stay in "normal" (not bypassed)
+		 * mode - bypassing it there starves the LUT of old-image
+		 * data and produces a weak/incomplete, faded-looking drive.
+		 * Matches Waveshare's EPD_4in2_V2.c reference exactly: 0x40
+		 * for its Init()/full Display(), 0x00 for
+		 * PartialDisplay().
+		 */
+		const uint8_t ctrl1[] = {
+			type == SSD16XX_PROFILE_FULL ? 0x40 : 0x00,
+			0x00,
+		};
+
+		err = ssd16xx_write_cmd(dev, SSD16XX_CMD_UPDATE_CTRL1, ctrl1,
+					sizeof(ctrl1));
+		if (err < 0) {
+			return err;
+		}
+	}
+
 	gdo_len = push_y_param(dev, gdo, last_gate);
 	gdo[gdo_len++] = 0U;
 	err = ssd16xx_write_cmd(dev, SSD16XX_CMD_GDO_CTRL, gdo, gdo_len);
