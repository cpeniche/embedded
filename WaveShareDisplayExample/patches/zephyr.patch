@@ -64,6 +64,58 @@ struct ssd16xx_quirks {
 	 * SSD16XX_CMD_UPDATE_CTRL2 for a partial refresh.
 	 */
 	uint8_t ctrl2_partial;
+
+	/*
+	 * Some panels' black RAM plane is optically inverted relative to
+	 * the PIXEL_FORMAT_MONO10 contract (1=black, 0=white) the rest of
+	 * this driver assumes - same class of panel-specific quirk as the
+	 * gray-level-to-ink-color mapping on other EPD controllers. The
+	 * driver writes bits through unchanged either way; only the
+	 * declared pixel format changes, so Zephyr's LVGL glue picks the
+	 * correct fill/bit-sense for whichever contract is actually true
+	 * for the panel. Confirmed needed for gooddisplay's SSD1683-based
+	 * 4.2" 300x400 panel; leave false for chips already working
+	 * without it.
+	 */
+	bool inverted;
+
+	/*
+	 * Zephyr's LVGL mono glue (lvgl_transform_buffer() in
+	 * lvgl_display_mono.c) packs its internal render buffer to a
+	 * byte (8-pixel) boundary and lets that padded width leak into
+	 * the width it reports to display_write() when a partial-width
+	 * flush area isn't itself a multiple of 8 - e.g. a 300px-wide
+	 * panel gets sent width=304, tripping this driver's own bounds
+	 * check against the true 300px config->width. Setting this
+	 * forces every flush to use the SCREEN_INFO_X_ALIGNMENT_WIDTH
+	 * path instead (full logical width every time, no rounding),
+	 * which sidesteps the mismatch entirely. Harmless no-op for
+	 * chips whose configured width already happens to be a multiple
+	 * of 8. Confirmed needed for the SSD1683 (300px wide).
+	 */
+	bool full_width_only;
+
+	/*
+	 * Send SSD16XX_CMD_UPDATE_CTRL1 (0x21, "Display Update Control 1")
+	 * with [0x40, 0x00] on every profile switch, matching Waveshare's
+	 * own EPD_4in2_V2.c reference driver for this chip family (sent
+	 * unconditionally in every one of its Init variants). Per the
+	 * SSD16xx-family register map this sets the RED RAM content
+	 * option to "bypass as 0" (upper nibble 0x4) and the BW RAM option
+	 * to "normal" (lower nibble 0x0) - i.e. it tells the controller to
+	 * ignore the second RAM plane entirely for display updates rather
+	 * than factoring it into the driven waveform.
+	 *
+	 * ssd16xx.c has never written this register for any panel
+	 * upstream, for either generation - it relies entirely on the
+	 * panel's power-on/OTP default. That default happens to work for
+	 * whatever panels were tested to add existing quirks entries, but
+	 * produced a stuck-black background on real SSD1683 hardware for
+	 * any full-profile write with real (non-uniform) content, exactly
+	 * the kind of symptom this register's RED-RAM-bypass bit would
+	 * explain. Confirmed against Waveshare's reference bytes.
+	 */
+	bool bypass_red_ram;
 };
 
