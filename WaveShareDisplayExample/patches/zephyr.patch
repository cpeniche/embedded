diff --git a/modules/lvgl/lvgl.c b/modules/lvgl/lvgl.c
index 9da32fb7929..067fae9ea79 100644
--- a/modules/lvgl/lvgl.c
+++ b/modules/lvgl/lvgl.c
@@ -186,8 +186,27 @@ static int lvgl_allocate_rendering_buffers(lv_display_t *display)
 		break;
 	case PIXEL_FORMAT_MONO01:
 	case PIXEL_FORMAT_MONO10:
-		buf_size = buf_nbr_pixels / 8 + 8;
-		buf_size += (buf_nbr_pixels % 8) == 0 ? 0 : 1;
+		/*
+		 * buf_nbr_pixels total pixels, laid out as
+		 * (buf_nbr_pixels / hor_res) rows of hor_res pixels each -
+		 * the VDB chunking convention (see lvgl_flush_cb_mono()).
+		 * LVGL's own internal per-row stride (lv_draw_buf.c:
+		 * width_to_stride()) rounds EACH ROW's byte count up to a
+		 * whole byte independently, not the flat total pixel count
+		 * - for a hor_res that isn't itself a multiple of 8, that's
+		 * a strictly larger number than buf_nbr_pixels / 8. Using
+		 * the flat total under-allocates whenever hor_res isn't a
+		 * multiple of 8 (every previously-exercised panel's
+		 * hor_res happened to be), overflowing this buffer (and the
+		 * identically-sized mono conversion buffer) once actually
+		 * rendered into at more than one row's height.
+		 */
+		{
+			uint32_t rows = (buf_nbr_pixels + hor_res - 1) / hor_res;
+			uint32_t row_bytes = (hor_res + 7) / 8;
+
+			buf_size = rows * row_bytes + 8;
+		}
 		break;
 	default:
 		return -ENOTSUP;
