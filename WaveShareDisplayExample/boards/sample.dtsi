&spi1{
	display:display@0{
		compatible = "vnd,spi-device";
    reg = <0>;
    spi-max-frequency = <1000000>;
  };
};

/{
  zephyr,user{
    display-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>, /* dc     22*/
                    <&gpio0 28 GPIO_ACTIVE_HIGH>, /* busy   24 */
                    <&gpio0 3 GPIO_ACTIVE_HIGH>,  /* reset  26 */
                    <&gpio1 15 GPIO_ACTIVE_HIGH>; /* power  30 */
  };
};
