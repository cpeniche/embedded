&{/chosen}{
  zephyr,console = &uart0;        
  zephyr,shell-uart = &uart0;     
	zephyr,uart-mcumgr = &uart0;    
	zephyr,bt-mon-uart = &uart0;    
	zephyr,bt-c2h-uart = &uart0;
};


&uart0_default{
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 4)>;
		};
    group2 {
			psels = <NRF_PSEL(UART_RX, 0, 5)>;
			bias-pull-up;
		};
	};

&uart0_sleep {
		group1 {
			psels = <NRF_PSEL(UART_RX, 0, 8)>,
				<NRF_PSEL(UART_RTS, 0, 5)>,
				<NRF_PSEL(UART_CTS, 0, 7)>;
			low-power-enable;
		};

		group2 {
			psels = <NRF_PSEL(UART_TX, 0, 6)>;
			low-power-enable;
			bias-pull-up;
		};
	};

&pwm0_default {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 11)>,
				<NRF_PSEL(PWM_OUT1, 0,13)>,
				<NRF_PSEL(PWM_OUT2, 0, 14)>;
			nordic,invert;
		};
};

&pwm0_sleep {
		group1 {
			psels = <NRF_PSEL(PWM_OUT0, 0, 11)>,
				<NRF_PSEL(PWM_OUT1, 0, 13)>,
				<NRF_PSEL(PWM_OUT2, 0, 14)>;
			low-power-enable;
	};
};

&led1_red {
			gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
			label = "Red LED 1";
		};

&i2c0_default{
	group1 {
			psels = <NRF_PSEL(TWIM_SDA, 0, 23)>,
				<NRF_PSEL(TWIM_SCL, 0, 24)>;
	};
};	

&spi1_default{
	group1{
		psels = <NRF_PSEL(SPIM_SCK,0,14)>,
						<NRF_PSEL(SPIM_MOSI,0,31)>;
	};
};


&spi1{
	cs-gpios =<&gpio0 30 GPIO_ACTIVE_LOW>;		
	display:display@0{
		compatible = "vnd,spi-device";
    reg = <0>;
    spi-max-frequency = <1000000>;
  };
};		

/{
  zephyr,user{
    display-gpios = <&gpio0 29 GPIO_ACTIVE_HIGH>, /* cn */
                    <&gpio0 28 GPIO_ACTIVE_HIGH>, /* busy */
                    <&gpio0 3 GPIO_ACTIVE_HIGH>, /* reset */
                    <&gpio1 15 GPIO_ACTIVE_HIGH>; /* power */
  };
};




